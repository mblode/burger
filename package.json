{
  "name": "the-burger",
  "version": "2.0.3",
  "description": "Burger is a minimal hamburger menu with fullscreen navigation.",
  "keywords": [
    "accessible",
    "blode",
    "burger",
    "css",
    "fullscreen",
    "hamburger",
    "javascript",
    "matt",
    "matthew blode",
    "mblode",
    "menu",
    "navigation",
    "no-dependencies"
  ],
  "homepage": "https://blode.co/burger",
  "bugs": {
    "url": "https://github.com/mblode/burger/issues"
  },
  "license": "MIT",
  "author": "Matthew Blode https://github.com/mblode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/burger.git"
  },
  "style": "./dist/css/burger.min.css",
  "files": [
    "dist",
    "src",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/scripts/*.js",
    "./src/scripts/*.js"
  ],
  "main": "./dist/scripts/burger.js",
  "exports": {
    ".": "./dist/scripts/burger.js",
    "./css": "./dist/css/burger.css",
    "./css/min": "./dist/css/burger.min.css",
    "./css/*": "./dist/css/*",
    "./scripts/*": "./dist/scripts/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:css:min && npm run build:js && npm run build:assets",
    "build:css": "lightningcss --bundle --browserslist src/burger.css -o dist/css/burger.css",
    "build:css:min": "cd dist/css && lightningcss --bundle --browserslist --minify --sourcemap ../../src/burger.css -o burger.min.css",
    "build:js": "esbuild src/scripts/burger.js --format=esm --outfile=dist/scripts/burger.js && esbuild src/scripts/burger.js --format=esm --minify --sourcemap --outfile=dist/scripts/burger.min.js",
    "build:assets": "mkdir -p dist/img && cp src/index.html dist/index.html && cp -R src/img/. dist/img/",
    "build:site": "rm -rf site && mkdir -p site/burger && cp -R dist/. site/burger/",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "npm run build && changeset publish",
    "test": "npm run lint && npm run format:check && npm run build && npx publint",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "browserslist": "^4.28.6",
    "esbuild": "^0.27.0",
    "lefthook": "^2.1.10",
    "lightningcss-cli": "^1.32.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "publint": "^0.3.21",
    "ultracite": "7.9.3"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "firefox >= 128",
    "safari >= 17.5",
    "ios_saf >= 17.5",
    "and_chr >= 123",
    "and_ff >= 128",
    "samsung >= 27",
    "opera >= 109"
  ]
}
